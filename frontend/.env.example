# Optional; local development defaults to http://localhost:8000.
# Cloud builds default to /api. Set an HTTPS API URL once the backend exists.
VITE_API_BASE_URL=
# Copy to .env.local for local-only unauthenticated analytics development.
# Remove demo and supply the AuthStack outputs to test real login.
VITE_AUTH_MODE=demo
VITE_AUTH_ISSUER=
VITE_AUTH_CLIENT_ID=
VITE_AUTH_DOMAIN=
